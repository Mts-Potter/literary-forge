# ===========================================================================
# Literary Forge — .env.local template
# ===========================================================================
# Copy to .env.local and fill in real values. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase (Auth + DB)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# ---------------------------------------------------------------------------
# Google Gemini (LLM backend)
# Get an API key from: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# ---------------------------------------------------------------------------
# NLP Microservice (Render-hosted Python+Flask+spaCy)
# See nlp-service/README.md for deployment details.
# Set a strong shared secret to prevent abuse.
# ---------------------------------------------------------------------------
NLP_SERVICE_URL=https://your-nlp-service.onrender.com
NLP_SHARED_SECRET=your_shared_secret_here

# ---------------------------------------------------------------------------
# Cron Secret (Vercel Cron + Render Keep-Alive)
# Used as a bearer token by /api/cron/* and /api/nlp/warm routes.
# ---------------------------------------------------------------------------
CRON_SECRET=generate_with_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Resend (Email — Feedback form, account notifications)
# Get an API key from: https://resend.com/api-keys
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_key_here

# ---------------------------------------------------------------------------
# Public Site URL (used in canonical links + emails)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.example
